# Fill these in, then copy this file to ".env" (which is gitignored).
SERVER_URL=https://your-app-name.ondigitalocean.app
API_SECRET=replace-with-the-same-secret-you-set-on-the-server
# Leave blank to auto-detect (checks both %OneDrive%\Pictures\Screenshots and
# %USERPROFILE%\Pictures\Screenshots, since OneDrive often redirects Pictures).
# Only set this if your screenshots live somewhere else entirely.
SCREENSHOT_DIR=
POLL_SECONDS=3
